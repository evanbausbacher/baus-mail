# Database
# Required locally. Hosted providers may expose POSTGRES_URL variants instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bausmail
DATABASE_POOL_MAX=10

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Comma-separated admin email allowlist, e.g. founder@example.com,ops@example.com
AUTH_ALLOWED_EMAILS=
# Shared password for allowed admin emails. Use a strong random value.
AUTH_ADMIN_PASSWORD=

# Resend webhooks
# Signing secret from the Resend webhook endpoint.
RESEND_WEBHOOK_SECRET=
# Server-only JSON map of domain names to Resend API keys.
# Example: {"example.com":"<resend-api-key-for-example.com>"}
RESEND_DOMAIN_API_KEYS={}

# Polling interval (milliseconds)
NEXT_PUBLIC_POLLING_INTERVAL=30000
