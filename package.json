{
  "name": "bausmail",
  "version": "0.1.0",
  "description": "Self-hosted Resend email client for indie devs and founders managing multiple app domains.",
  "private": false,
  "license": "MIT",
  "author": "Evan Bausbacher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanbausbacher/baus-mail.git"
  },
  "bugs": {
    "url": "https://github.com/evanbausbacher/baus-mail/issues"
  },
  "homepage": "https://github.com/evanbausbacher/baus-mail#readme",
  "keywords": [
    "email",
    "resend",
    "nextjs",
    "self-hosted",
    "indie-hackers",
    "founders",
    "mailbox"
  ],
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "next dev",
    "prebuild": "npm run version:sync",
    "build": "next build",
    "prebuild:vercel": "npm run version:sync",
    "build:vercel": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "version:sync": "node scripts/sync-package-version.mjs",
    "prepack": "npm run version:sync",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-beta.23",
    "isomorphic-dompurify": "3.10.0",
    "lucide-react": "0.563.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "pg": "8.20.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "svix": "1.92.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "1.0.0-beta.23",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "postcss": "8.5.12",
    "tailwindcss": "^3.4.14",
    "tsx": "4.21.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "minimatch": {
      "brace-expansion": "1.1.14"
    },
    "next": {
      "postcss": "8.5.12"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "tinyglobby": {
      "picomatch": "4.0.4"
    }
  }
}
